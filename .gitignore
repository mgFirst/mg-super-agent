# .gitignore：忽略 Node.js 与 Python 项目的常见构建产物、依赖目录与本地环境变量文件

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
.nyc_output/
*.tsbuildinfo
.eslintcache
.next/
.nuxt/
.vite/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
venv/
.venv/
env/

# ---- 构建产物（Node.js 与 Python 共用）----
dist/
build/

# ---- 本地环境变量 ----
.env
.env.*
!.env.example
!.env.local.example
